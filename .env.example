# Copier vers .env (jamais commité) et remplacer TOUTES les valeurs.
DB_PASSWORD=change-me
# Générer : openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8081
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Premier SUPER_ADMIN (créé au démarrage s'il n'existe pas). Mot de passe >= 12 caractères. Retirer ensuite de l'environnement.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
